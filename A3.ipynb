  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "\n",
    "# Create a class for encode columns\n",
    "colTrans = ColumnTransformer(transformers = [('encode', OneHotEncoder(), [0])], remainder = 'passthrough')\n",
    "\n",
    "# Encode\n",
    "train_set = colTrans.fit_transform(train_set)\n",
    "# train_set[0]\n",
    "test_set = colTrans.transform(test_set)\n",
    "# test_set[0]"
   ]
  },
