   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "std_scaler = StandardScaler()\n",
    "\n",
    "# Just only scale numerical features in training and testing set, not category feature\n",
    "train_set[:, 3:] = std_scaler.fit_transform(train_set[:, 3:])\n",
    "test_set[:, 3:] = std_scaler.transform(test_set[:, 3:])"
