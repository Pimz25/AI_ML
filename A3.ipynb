  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Use Z-Score Threshold\n",
    "for col in abalone_df.columns:\n",
    "    if col != 'Type':\n",
    "        # print(len(abalone_df[col]))\n",
    "        threshold = 3\n",
    "        mean_num = np.mean(abalone_df[col])\n",
    "        std_num = np.std(abalone_df[col])\n",
    "\n",
    "# on working"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.3. Split the data <a id=\"data_preprocessing_3\"></a>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# Split the raw data: abalone_train (80%) for training and abalone_test (20%) for testing with the percentage\n",
    "abalone_train, abalone_test = train_test_split(abalone_df, test_size = 0.2, random_state = 25)\n",
    "\n",
    "# Uncomment to se the outcome\n",
    "abalone_train.shape, abalone_test.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.4. Separate labels from data <a id=\"data_preprocessing_4\"></a>\n",
    "Choosing \"Rings\" column as the label."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Split train set\n",
    "train_set_labels = abalone_train['Rings'].copy()\n",
    "train_set = abalone_train.drop(columns = 'Rings', inplace = False)\n",
    "\n",
    "# Split test set\n",
    "test_set_labels = abalone_test['Rings'].copy()\n",
    "test_set = abalone_test.drop(columns = 'Rings', inplace = False)"
   ]
  },
